            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.twenty.com/rest/metadata/objects"
          },
          "docs": "Returns the object definitions (standard and custom) in the workspace schema."
        },
        {
          "info": {
            "name": "Create an object",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.twenty.com/rest/metadata/objects",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new custom object. Its records immediately gain matching REST and GraphQL endpoints."
        },
        {
          "info": {
            "name": "Get an object definition",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.twenty.com/rest/metadata/objects/:id",
            "params": [
              {
                "name": "id",
                "value": "",
