{
  "opencollection": "1.0.0",
  "info": {
    "name": "Twenty CRM Companies Metadata - Objects API",
    "version": "0.40"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
